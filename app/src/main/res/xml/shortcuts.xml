        android:shortcutId="instant_photocopy"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_instant_copy_short"
        android:shortcutLongLabel="@string/shortcut_instant_copy_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.dodopress"
            android:targetClass="com.dodopress.ui.MainActivity">
            <extra android:name="extra_instant_photocopy" android:value="true" />
        </intent>
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
</shortcuts>
