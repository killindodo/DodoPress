<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header & Live Printer Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DodoPress"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_high"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/btn_chip"
                    android:paddingLeft="8dp"
                    android:paddingTop="2dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="2dp"
                    android:text="PRO"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_primary"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_printer_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/status_badge_waiting"
                android:paddingLeft="12dp"
                android:paddingTop="6dp"
                android:paddingRight="12dp"
                android:paddingBottom="6dp"
                android:text="○ Checking USB..."
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/status_waiting_text"/>
        </LinearLayout>

        <!-- Card 1: Document Selection & Interactive Preview -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <Button
                android:id="@+id/btn_pick_file"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/btn_primary"
                android:text="@string/btn_select_document"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_file_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="No PDF document selected yet"
                android:textColor="@color/text_med"
                android:textSize="12sp"/>

            <!-- Embedded Live Page Preview -->
            <LinearLayout
                android:id="@+id/layout_preview_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="12dp">

                <!-- Preview Header & Interactive Tools -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/tv_preview_mode_badge"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⚡ Deep Ink Preview"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_primary"/>

                    <Button
                        android:id="@+id/btn_toggle_preview_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/btn_chip"
                        android:textColor="@color/text_high"
                        android:textSize="11sp"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:text="Compare: Original"/>

                    <Button
                        android:id="@+id/btn_quick_zoom"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginLeft="6dp"
                        android:background="@drawable/btn_chip"
                        android:textColor="@color/brand_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:text="🔍 Zoom"/>
                </LinearLayout>

                <!-- High-Resolution Paper Sheet Frame -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="320dp"
                    android:background="#0A0F1D"
                    android:padding="6dp">

                    <com.dodopress.ui.ZoomableImageView
                        android:id="@+id/iv_page_preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#FFFFFF"/>
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_marginTop="6dp"
                    android:text="💡 Tip: Pinch or double-tap anywhere on the preview to zoom and inspect font sharpness"
                    android:textSize="11sp"
                    android:textColor="@color/text_med"/>

                <!-- Pagination Stepper -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btn_prev_page"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/btn_secondary"
                        android:textColor="@color/text_high"
                        android:text="◀ Prev"/>

                    <TextView
                        android:id="@+id/tv_page_indicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"
                        android:text="Page 1 of 1"
                        android:textStyle="bold"
                        android:textColor="@color/brand_primary"/>

                    <Button
                        android:id="@+id/btn_next_page"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/btn_secondary"
                        android:textColor="@color/text_high"
                        android:text="Next ▶"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Card 2: Ink Darkness / Tone Curve Lab -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ink_density_title"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_high"/>

                <TextView
                    android:id="@+id/tv_darkness_pct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="75%"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_primary"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ink_density_desc"
                android:textSize="12sp"
                android:textColor="@color/text_med"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp"/>

            <SeekBar
                android:id="@+id/seek_darkness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="75"/>

            <TextView
                android:id="@+id/tv_darkness_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="75% — Deep Black (PC Match)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/brand_primary"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"/>

            <!-- Quick-Preset Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btn_preset_draft"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginRight="4dp"
                    android:background="@drawable/btn_chip"
                    android:text="Draft (25%)"
                    android:textSize="10sp"
                    android:textColor="@color/text_med"/>

                <Button
                    android:id="@+id/btn_preset_normal"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginRight="4dp"
                    android:background="@drawable/btn_chip"
                    android:text="Standard (50%)"
                    android:textSize="10sp"
                    android:textColor="@color/text_med"/>

                <Button
                    android:id="@+id/btn_preset_deep"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1.3"
                    android:layout_marginRight="4dp"
                    android:background="@drawable/btn_primary"
                    android:text="Deep (PC Match ★)"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>

                <Button
                    android:id="@+id/btn_preset_ultra"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1.1"
                    android:background="@drawable/btn_chip"
                    android:text="Max Deep (100%)"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_primary"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Card 3: Print Hardware Configuration -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <!-- Hardware Laser Engine Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/status_badge_connected"
                android:paddingLeft="12dp"
                android:paddingTop="8dp"
                android:paddingRight="12dp"
                android:paddingBottom="8dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⚡ 300 DPI Native Laser Engine"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/status_connected_text"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FAST &amp; SOLID TONER"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/status_connected_text"/>
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/surface_card_border"
                android:layout_marginBottom="12dp"/>

            <!-- Copies Section with Collation Option -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <!-- Copies Stepper -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/copies_title"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_high"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp">

                        <Button
                            android:id="@+id/btn_copies_minus"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/btn_secondary"
                            android:textColor="@color/text_high"
                            android:text="−"
                            android:textSize="16sp"/>

                        <TextView
                            android:id="@+id/tv_copies_count"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="1"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/brand_primary"/>

                        <Button
                            android:id="@+id/btn_copies_plus"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/btn_secondary"
                            android:textColor="@color/text_high"
                            android:text="+"
                            android:textSize="16sp"/>
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="16dp"
                    android:layout_height="1dp" />

                <!-- Collate Checkbox -->
                <CheckBox
                    android:id="@+id/cb_collate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/order_collate"
                    android:checked="true"
                    android:textSize="12sp"
                    android:textColor="@color/text_med"/>
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/surface_card_border"
                android:layout_marginBottom="12dp"/>

            <!-- Page Selection (Windows Style) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pages_title"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_high"/>

            <RadioGroup
                android:id="@+id/rg_pages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp">

                <RadioButton
                    android:id="@+id/rb_pages_all"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:textSize="13sp"
                    android:textColor="@color/text_high"
                    android:text="@string/pages_all"/>

                <RadioButton
                    android:id="@+id/rb_pages_current"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/text_high"
                    android:text="@string/pages_current"/>

                <RadioButton
                    android:id="@+id/rb_pages_odd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/text_high"
                    android:text="@string/pages_odd"/>

                <RadioButton
                    android:id="@+id/rb_pages_even"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/text_high"
                    android:text="@string/pages_even"/>

                <RadioButton
                    android:id="@+id/rb_pages_custom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/text_high"
                    android:text="@string/pages_custom"/>
            </RadioGroup>

            <!-- Custom Page Range Input (Visible when Custom is selected) -->
            <LinearLayout
                android:id="@+id/layout_custom_range"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="6dp"
                android:layout_marginLeft="28dp">

                <EditText
                    android:id="@+id/et_custom_pages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/input_bg"
                    android:hint="@string/pages_custom_hint"
                    android:textColorHint="@color/text_muted"
                    android:textColor="@color/text_high"
                    android:textSize="13sp"
                    android:singleLine="true"
                    android:inputType="textNoSuggestions" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tip: Use commas and hyphens (e.g. 1-3, 5, 8-10)"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <!-- Reverse Order Option -->
            <CheckBox
                android:id="@+id/cb_reverse_order"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/order_reverse"
                android:checked="false"
                android:textSize="12sp"
                android:textColor="@color/text_high"/>

            <!-- Real-time Live Page Summary Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/badge_info"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_page_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📄 All pages selected • 1 copy"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_primary"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Live Print Status & Progress Bar -->
        <ProgressBar
            android:id="@+id/pb_print_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:visibility="gone"
            android:progressBackgroundTint="@color/slider_track"
            android:progressTint="@color/brand_primary"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tv_print_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:visibility="gone"
            android:text="Preparing print..."
            android:textColor="@color/brand_primary"
            android:textSize="13sp"
            android:layout_marginBottom="12dp"/>

        <!-- Primary Action Button -->
        <Button
            android:id="@+id/btn_print_now"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/btn_primary"
            android:text="@string/btn_print_now"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:elevation="4dp"/>

    </LinearLayout>
</ScrollView>
