<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_dark">

    <LinearLayout
        android:id="@+id/root_linear_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 1. Authentic Windows XP Luna Blue Title Bar (Active in Windows XP theme) -->
        <LinearLayout
            android:id="@+id/layout_xp_titlebar"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/theme_titlebar_xp"
            android:visibility="gone"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:src="@drawable/ic_printer"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Print - HP LaserJet M1005 MFP"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp"
                android:shadowColor="#00185A"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="1"/>

            <!-- XP Window Buttons -->
            <TextView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:gravity="center"
                android:background="@drawable/theme_btn_xp"
                android:text="_"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginRight="3dp"/>

            <TextView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:gravity="center"
                android:background="@drawable/theme_btn_xp"
                android:text="□"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginRight="3dp"/>

            <TextView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:gravity="center"
                android:background="#D84234"
                android:text="✕"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginRight="4dp"/>
        </LinearLayout>

        <!-- 2. Modern Glass Top Navigation Bar -->
        <LinearLayout
            android:id="@+id/layout_modern_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <!-- Brand Title & PRO Badge -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_app_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DodoPress"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_high"/>

                <TextView
                    android:id="@+id/tv_pro_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:background="@drawable/btn_chip"
                    android:paddingLeft="8dp"
                    android:paddingTop="2dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="2dp"
                    android:text="PRO"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_primary"/>
            </LinearLayout>

            <!-- Quick Telemetry & Diagnostics Pill -->
            <Button
                android:id="@+id/btn_diagnostics"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/btn_icon_pill"
                android:text="⚡ Logs"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/brand_primary"
                android:layout_marginRight="6dp"/>

            <!-- Animated Status Capsule with Living Beacon -->
            <LinearLayout
                android:id="@+id/layout_status_capsule"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/badge_status_offline"
                android:paddingLeft="8dp"
                android:paddingRight="10dp">

                <com.dodopress.ui.PulsingBeaconView
                    android:id="@+id/view_beacon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginRight="6dp"/>

                <TextView
                    android:id="@+id/tv_printer_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Checking USB..."
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/status_waiting_text"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 3. Interactive Theme Switcher Bar (5 Themes) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tv_theme_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎨 Visual Theme:"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/text_med"
                android:layout_marginBottom="6dp"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/btn_theme_xp"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/btn_theme_chip"
                        android:text="🪟 Windows XP"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginRight="6dp"/>

                    <Button
                        android:id="@+id/btn_theme_midnight"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/btn_theme_chip"
                        android:text="🌙 Midnight"
                        android:textSize="11sp"
                        android:textColor="@color/text_med"
                        android:layout_marginRight="6dp"/>

                    <Button
                        android:id="@+id/btn_theme_studio"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/btn_theme_chip"
                        android:text="☀️ Studio"
                        android:textSize="11sp"
                        android:textColor="@color/text_med"
                        android:layout_marginRight="6dp"/>

                    <Button
                        android:id="@+id/btn_theme_cyber"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/btn_theme_chip"
                        android:text="⚡ Cyber"
                        android:textSize="11sp"
                        android:textColor="@color/text_med"
                        android:layout_marginRight="6dp"/>

                    <Button
                        android:id="@+id/btn_theme_warm"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/btn_theme_chip"
                        android:text="📜 Vintage"
                        android:textSize="11sp"
                        android:textColor="@color/text_med"/>
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- 4. Recent Prints Shelf (Horizontal Carousel) -->
        <LinearLayout
            android:id="@+id/card_recents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tv_recents_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📁 Recent Documents"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_high"/>

                <TextView
                    android:id="@+id/btn_clear_recents"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clear"
                    android:textSize="11sp"
                    android:textColor="@color/brand_primary"
                    android:padding="4dp"/>
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layout_recents_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- 5. Hero Stage: Document Selection & Interactive Paper Canvas -->
        <LinearLayout
            android:id="@+id/card_doc_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tv_xp_group_doc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="── Document &amp; Live Preview ──"
                android:textColor="#003399"
                android:textStyle="bold"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginBottom="6dp"/>

            <!-- Document Upload Vault Button -->
            <Button
                android:id="@+id/btn_pick_file"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/btn_primary"
                android:text="@string/btn_select_document"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_file_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="No PDF document selected yet"
                android:textColor="@color/text_med"
                android:textSize="12sp"/>

            <!-- Embedded Live Page Preview -->
            <LinearLayout
                android:id="@+id/layout_preview_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="12dp">

                <!-- Floating Island Toolbar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/tv_preview_mode_badge"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⚡ Deep Ink Preview"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_primary"/>

                    <Button
                        android:id="@+id/btn_toggle_preview_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/btn_chip"
                        android:textColor="@color/text_high"
                        android:textSize="11sp"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:text="Compare: Original"/>

                    <Button
                        android:id="@+id/btn_quick_zoom"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginLeft="6dp"
                        android:background="@drawable/btn_chip"
                        android:textColor="@color/brand_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:text="🔍 Zoom"/>
                </LinearLayout>

                <!-- High-Resolution Paper Sheet Frame with Laser Scan Overlay -->
                <FrameLayout
                    android:id="@+id/frame_paper_preview"
                    android:layout_width="match_parent"
                    android:layout_height="320dp"
                    android:background="#0A0F1D"
                    android:padding="6dp">

                    <com.dodopress.ui.ZoomableImageView
                        android:id="@+id/iv_page_preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#FFFFFF"/>

                    <com.dodopress.ui.LaserScanView
                        android:id="@+id/laser_scan_view"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone"/>
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_zoom_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_marginTop="6dp"
                    android:text="💡 Tip: Pinch or double-tap anywhere on the preview to zoom and inspect font sharpness"
                    android:textSize="11sp"
                    android:textColor="@color/text_med"/>

                <!-- Pagination Stepper -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btn_prev_page"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/btn_secondary"
                        android:textColor="@color/text_high"
                        android:text="◀ Prev"/>

                    <TextView
                        android:id="@+id/tv_page_indicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"
                        android:text="Page 1 of 1"
                        android:textStyle="bold"
                        android:textColor="@color/brand_primary"/>

                    <Button
                        android:id="@+id/btn_next_page"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/btn_secondary"
                        android:textColor="@color/text_high"
                        android:text="Next ▶"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 6. Card: Laser Toner Studio (PC Match Engine) -->
        <LinearLayout
            android:id="@+id/card_toner_density"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tv_xp_group_density"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="── Print Density &amp; Toner Quality ──"
                android:textColor="#003399"
                android:textStyle="bold"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginBottom="6dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_density_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ink_density_title"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_high"/>

                <TextView
                    android:id="@+id/tv_darkness_pct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="75%"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_primary"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_density_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ink_density_desc"
                android:textSize="12sp"
                android:textColor="@color/text_med"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="10dp"/>

            <SeekBar
                android:id="@+id/seek_darkness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="75"/>

            <TextView
                android:id="@+id/tv_darkness_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="75% — Deep Black (PC Match — Locked Default)"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/brand_primary"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="10dp"/>

            <!-- Quick-Preset Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btn_preset_draft"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginRight="4dp"
                    android:background="@drawable/btn_chip"
                    android:text="Draft (25%)"
                    android:textSize="10sp"
                    android:textColor="@color/text_med"/>

                <Button
                    android:id="@+id/btn_preset_normal"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginRight="4dp"
                    android:background="@drawable/btn_chip"
                    android:text="Standard (50%)"
                    android:textSize="10sp"
                    android:textColor="@color/text_med"/>

                <Button
                    android:id="@+id/btn_preset_deep"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1.3"
                    android:layout_marginRight="4dp"
                    android:background="@drawable/btn_primary"
                    android:text="Deep (PC Match ★)"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>

                <Button
                    android:id="@+id/btn_preset_ultra"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1.1"
                    android:background="@drawable/btn_chip"
                    android:text="Max Deep (100%)"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_primary"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 7. Card: Print Geometry, Copies & Page Range -->
        <LinearLayout
            android:id="@+id/card_page_config"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tv_xp_group_pages"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="── Print Range &amp; Copies ──"
                android:textColor="#003399"
                android:textStyle="bold"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginBottom="6dp"/>

            <!-- Hardware Laser Engine Info -->
            <LinearLayout
                android:id="@+id/layout_engine_badge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/status_badge_connected"
                android:paddingLeft="10dp"
                android:paddingTop="6dp"
                android:paddingRight="10dp"
                android:paddingBottom="6dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tv_engine_info"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⚡ 300 DPI Native Laser Engine"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/status_connected_text"/>

                <TextView
                    android:id="@+id/tv_engine_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SOLID TONER"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/status_connected_text"/>
            </LinearLayout>

            <!-- Copies Section with Collation Option -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <!-- Copies Stepper -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_copies_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/copies_title"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_high"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp">

                        <Button
                            android:id="@+id/btn_copies_minus"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/btn_secondary"
                            android:textColor="@color/text_high"
                            android:text="−"
                            android:textSize="16sp"/>

                        <TextView
                            android:id="@+id/tv_copies_count"
                            android:layout_width="38dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="1"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/brand_primary"/>

                        <Button
                            android:id="@+id/btn_copies_plus"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/btn_secondary"
                            android:textColor="@color/text_high"
                            android:text="+"
                            android:textSize="16sp"/>
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="16dp"
                    android:layout_height="1dp" />

                <!-- Collate Checkbox -->
                <CheckBox
                    android:id="@+id/cb_collate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/order_collate"
                    android:checked="true"
                    android:textSize="12sp"
                    android:textColor="@color/text_med"/>
            </LinearLayout>

            <!-- Page Selection (Windows Style) -->
            <TextView
                android:id="@+id/tv_pages_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pages_title"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_high"/>

            <RadioGroup
                android:id="@+id/rg_pages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp">

                <RadioButton
                    android:id="@+id/rb_pages_all"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:textSize="12sp"
                    android:textColor="@color/text_high"
                    android:text="@string/pages_all"/>

                <RadioButton
                    android:id="@+id/rb_pages_current"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/text_high"
                    android:text="@string/pages_current"/>

                <RadioButton
                    android:id="@+id/rb_pages_odd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/text_high"
                    android:text="@string/pages_odd"/>

                <RadioButton
                    android:id="@+id/rb_pages_even"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/text_high"
                    android:text="@string/pages_even"/>

                <RadioButton
                    android:id="@+id/rb_pages_custom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/text_high"
                    android:text="@string/pages_custom"/>
            </RadioGroup>

            <!-- Custom Page Range Input (Visible when Custom is selected) -->
            <LinearLayout
                android:id="@+id/layout_custom_range"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="4dp"
                android:layout_marginLeft="28dp">

                <EditText
                    android:id="@+id/et_custom_pages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/input_bg"
                    android:hint="@string/pages_custom_hint"
                    android:textColorHint="@color/text_muted"
                    android:textColor="@color/text_high"
                    android:textSize="13sp"
                    android:singleLine="true"
                    android:inputType="textNoSuggestions" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tip: Use commas and hyphens (e.g. 1-3, 5, 8-10)"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <!-- Reverse Order Option -->
            <CheckBox
                android:id="@+id/cb_reverse_order"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/order_reverse"
                android:checked="false"
                android:textSize="12sp"
                android:textColor="@color/text_high"/>

            <!-- Real-time Live Page Summary Badge -->
            <LinearLayout
                android:id="@+id/layout_page_summary_badge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/badge_info"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_page_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📄 All pages selected • 1 copy"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_primary"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 8. Live Print Status & Progress Bar -->
        <ProgressBar
            android:id="@+id/pb_print_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:visibility="gone"
            android:progressBackgroundTint="@color/slider_track"
            android:progressTint="@color/brand_primary"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tv_print_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:visibility="gone"
            android:text="Preparing print..."
            android:textColor="@color/brand_primary"
            android:textSize="13sp"
            android:layout_marginBottom="10dp"/>

        <!-- 9. Primary Action Button -->
        <Button
            android:id="@+id/btn_print_now"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/btn_primary"
            android:text="@string/btn_print_now"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:elevation="4dp"/>

        <!-- 10. Proper Branding Footer -->
        <LinearLayout
            android:id="@+id/card_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tv_footer_branding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Made by killindodo with love ❤️"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/brand_primary"/>

            <TextView
                android:id="@+id/tv_footer_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DodoPress Pro • Free &amp; Ad-Free Offline Printing"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
